{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.4",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/heuristics.js",
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/heuristics.iso.js",
        "src/lists.js",
        "src/badges.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/seed-channels.json",
        "data/ai-channels.json"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}