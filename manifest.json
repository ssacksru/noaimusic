{
  "manifest_version": 3,
  "name": "NoAI Music — AI 음악 플레이리스트 필터",
  "version": "0.1.0",
  "description": "유튜브 추천·검색·자동재생에서 AI로 만든 음악 플레이리스트를 걸러냅니다. 일반 영상은 건드리지 않습니다.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/heuristics.js",
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/heuristics.iso.js",
        "src/lists.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/seed-channels.json",
        "data/ai-channels.json"
      ],
      "matches": [
        "https://www.youtube.com/*"
      ]
    }
  ]
}